{:paths ["src"]
 ;; Desktop/dense-data platform binding on top of kotoba-ui.core — supplies
 ;; default option maps only (thick/regular surfaces, multi-pane conventions).
 ;; Owns no tokens/CSS/component logic; never modifies shitsuke/liquid-glass-ui/
 ;; kotoba-ui. See docs/adr/0001-appkit.md.
 :deps {io.github.kotoba-lang/kotoba-ui {:git/url "https://github.com/kotoba-lang/kotoba-ui.git"
         :git/sha "4167b3aa911690368bb47b61e825c47d3327bfac"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :local {:override-deps {io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
